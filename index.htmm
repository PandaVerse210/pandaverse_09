
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Panda Gamer School</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box}
body{margin:0;background:#091323;color:white;font-family:Arial}
header{background:#111f33;padding:16px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px}
h1,h2{color:#10d99a}
main{max-width:900px;margin:auto;padding:15px}
button,.btn{background:#10d99a;color:#06251b;border:0;padding:11px;border-radius:8px;cursor:pointer;font-weight:bold;margin:3px}
input,textarea{width:100%;padding:12px;margin:7px 0;background:#0b1729;color:white;border:1px solid #34445b;border-radius:8px}
.card{background:#14243a;padding:15px;border-radius:12px;margin:10px 0}
nav{padding:10px;display:flex;flex-wrap:wrap;gap:5px}
.tab{display:none}.active{display:block}
.hidden{display:none!important}
.chat{height:280px;overflow:auto;background:#0b1729;padding:10px;border-radius:8px}
.msg{padding:8px;margin:5px;background:#1c2e47;border-radius:8px}
small{color:#aab9ce}
</style>
</head>
<body>

<section id="login" class="card" style="max-width:400px;margin:50px auto;padding:20px">
<h1>🐼 Panda Gamer</h1>
<p>ESCOLA • JOGOS • LIVROS</p>
<input id="email" type="email" placeholder="E-mail">
<input id="password" type="password" placeholder="Senha (mínimo 6 caracteres)">
<input id="name" placeholder="Nome de jogador (para cadastro)">
<button onclick="auth(false)">Entrar</button>
<button onclick="auth(true)">Criar conta</button>
<p id="status"></p>
</section>

<div id="app" class="hidden">
<header>
<div>
<h2>🐼 Panda Gamer School</h2>
<small id="welcome"></small>
</div>
<div>🪙 <span id="coins">100</span> P-Coins</div>
<button onclick="logout()">Sair</button>
</header>

<nav>
<button onclick="tab('home')">🏠 Início</button>
<button onclick="tab('books')">📚 Livros</button>
<button onclick="tab('games')">🎮 Jogos</button>
<button onclick="tab('chat')">💬 Chat</button>
<button onclick="tab('ranking')">🏆 Ranking</button>
<button onclick="tab('profile')">👤 Perfil</button>
</nav>

<main>
<section id="home" class="tab active">
<div class="card">
<h1>Bem-vindo ao Mundo Panda! 🐼</h1>
<p>Leia, jogue e conheça outros jogadores!</p>
</div>
<div class="card">📚 Biblioteca compartilhada</div>
<div class="card">🎮 Arena Gamer</div>
<div class="card">💬 Converse com outros jogadores</div>
</section>

<section id="books" class="tab">
<h2>📚 Biblioteca</h2>
<button onclick="newBook()">+ Criar livro</button>
<div id="book-list"></div>
</section>

<section id="games" class="tab">
<h2>🎮 Jogos</h2>
<button onclick="newGame()">+ Publicar jogo</button>
<div id="game-list"></div>
</section>

<section id="chat" class="tab">
<h2>💬 Chat Panda</h2>
<div id="chat-box" class="chat"></div>
<input id="chat-input" maxlength="300" placeholder="Digite sua mensagem...">
<button onclick="sendMessage()">Enviar</button>
</section>

<section id="ranking" class="tab">
<h2>🏆 Ranking</h2>
<div id="ranking-list" class="card"></div>
</section>

<section id="profile" class="tab">
<h2>👤 Meu perfil</h2>
<div class="card">
<p id="profile-name"></p>
<p id="profile-email"></p>
<p>🪙 <span id="profile-coins"></span> P-Coins</p>
</div>
</section>
</main>
</div>

<script>
const URL="https://iwszwbthlkeichfaoebl.supabase.co";
const KEY="sb_publishable_rMmofAnzZIc7UDzhw3vGsg_t0CgaC2C";
const db=supabase.createClient(URL,KEY);

let user=null,profile=null,channel=null;
const $=id=>document.getElementById(id);

function safe(s){
return String(s??"").replace(/[&<>"']/g,c=>({
"&":"&amp;","<":"&lt;",">":"&gt;",
'"':"&quot;","'":"&#39;"
}[c]));
}

async function auth(register){
const email=$("email").value.trim();
const password=$("password").value;
const display_name=$("name").value.trim();
if(!email||password.length<6){
$("status").textContent="Informe e-mail e senha com 6 caracteres.";
return;
}
$("status").textContent="Conectando...";
let result;
if(register){
result=await db.auth.signUp({email,password,
options:{data:{display_name:display_name||"Jogador Panda"}}});
}else{
result=await db.auth.signInWithPassword({email,password});
}
if(result.error){$("status").textContent=result.error.message;return;}
if(register&&!result.data.session){
$("status").textContent="Confira seu e-mail para confirmar o cadastro.";
return;
}
if(result.data.session)await start();
}

async function start(){
const {data}=await db.auth.getUser();
user=data.user;
if(!user)return;
const result=await db.from("profiles").select("*").eq("id",user.id).single();
if(result.error){
$("status").textContent="Erro no perfil: "+result.error.message;
return;
}
profile=result.data;
$("login").classList.add("hidden");
$("app").classList.remove("hidden");
$("welcome").textContent="Olá, "+(profile.display_name||user.email);
$("coins").textContent=profile.coins;
$("profile-name").textContent=profile.display_name;
$("profile-email").textContent=user.email;
$("profile-coins").textContent=profile.coins;
await Promise.all([loadBooks(),loadGames(),loadChat(),loadRanking()]);
connectChat();
}

async function logout(){
if(channel)await db.removeChannel(channel);
await db.auth.signOut();
user=null;profile=null;
$("app").classList.add("hidden");
$("login").classList.remove("hidden");
}

function tab(id){
document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));
$(id).classList.add("active");
}

async function newBook(){
const title=prompt("Título do livro:");
if(!title)return;
const content=prompt("Escreva sua história:");
if(!content)return;
const {error}=await db.from("books").insert({title,content,author_id:user.id});
if(error)alert(error.message);else loadBooks();
}

async function loadBooks(){
const {data,error}=await db.from("books").select("id,title,content")
.order("created_at",{ascending:false});
if(error){console.error(error);return;}
$("book-list").innerHTML=data.map(b=>`
<div class="card"><h3>📘 ${safe(b.title)}</h3>
<button onclick="readBook('${b.id}')">Ler livro</button>
<div id="book-${b.id}" class="hidden"><p>${safe(b.content)}</p></div>
</div>`).join("")||"Nenhum livro publicado.";
}

function readBook(id){$("book-"+id).classList.toggle("hidden");}

async function newGame(){
const title=prompt("Nome do jogo:");
if(!title)return;
const url=prompt("Link do jogo:");
if(!url)return;
try{
const parsed=new URL(url);
if(!["https:","http:"].includes(parsed.protocol))throw Error();
const {error}=await db.from("games").insert({title,url:parsed.href,author_id:user.id});
if(error)alert(error.message);else loadGames();
}catch(e){alert("Link inválido.");}
}

async function loadGames(){
const {data,error}=await db.from("games").select("id,title,url")
.order("created_at",{ascending:false});
if(error){console.error(error);return;}
$("game-list").innerHTML=data.map(g=>`
<div class="card"><h3>🎮 ${safe(g.title)}</h3>
<a class="btn" href="${safe(g.url)}" target="_blank" rel="noopener">Jogar</a>
</div>`).join("")||"Nenhum jogo publicado.";
}

async function loadChat(){
const {data,error}=await db.from("chat_messages")
.select("id,message,user_id,created_at")
.order("created_at",{ascending:true}).limit(100);
if(error){console.error(error);return;}
renderChat(data);
}

function renderChat(messages){
$("chat-box").innerHTML=messages.map(m=>`
<div class="msg"><small>${m.user_id===user.id?"Você":"Jogador"}</small>
<p>${safe(m.message)}</p></div>`).join("");
$("chat-box").scrollTop=$("chat-box").scrollHeight;
}

async function sendMessage(){
const message=$("chat-input").value.trim();
if(!message)return;
const {error}=await db.from("chat_messages").insert({user_id:user.id,message});
if(error)alert(error.message);
else $("chat-input").value="";
}

function connectChat(){
if(channel)db.removeChannel(channel);
channel=db.channel("panda-chat")
.on("postgres_changes",{event:"INSERT",schema:"public",table:"chat_messages"},
()=>loadChat()).subscribe();
}

$("chat-input").addEventListener("keydown",e=>{
if(e.key==="Enter")sendMessage();
});

async function loadRanking(){
const {data,error}=await db.from("profiles")
.select("display_name,coins").order("coins",{ascending:false}).limit(50);
if(error){console.error(error);return;}
$("ranking-list").innerHTML=data.map((p,i)=>`
<p>${i+1}º 🐼 ${safe(p.display_name)} — 🪙 ${Number(p.coins)||0}</p>`).join("");
}

db.auth.onAuthStateChange((event,session)=>{
if(session&&!user)setTimeout(()=>start(),0);
});

(async()=>{
const {data}=await db.auth.getSession();
if(data.session)await start();
})();
</script>
</body>
</html>
